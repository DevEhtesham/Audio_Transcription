# Application
APP_NAME=audio-transcription-system
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
LOG_LEVEL=INFO

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transcription
DB_USER=postgres
DB_PASSWORD=postgres

# File storage
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=250
ALLOWED_EXTENSIONS=.wav,.mp3,.flac,.m4a,.ogg,.aac,.webm,.wma

# Transcription
MODEL_SIZE=tiny
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=3.0
MAX_RETRIES=3
STALE_JOB_TIMEOUT_SECONDS=1800
MODEL_CACHE_DIR=.cache/faster_whisper

# API frontend
API_BASE_URL=http://localhost:8000
